  {
    "compilerOptions": {
      "target": "ES6",                 
      "module": "ES6",                 
      "rootDir": "./src",              
      "outDir": "./spectral/js",              

      "strict": true,                  
      "sourceMap": true,               
      "declaration": false,            

      "moduleResolution": "node",      
      "resolveJsonModule": true,       
      "isolatedModules": false,        
      "skipLibCheck": true             
    },

    "include": ["src/**/*"],
    "exclude": ["node_modules"]
  }
